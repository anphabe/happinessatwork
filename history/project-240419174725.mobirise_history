olor=\"{{overlayColor}}\"></div>\n    <div class=\"align-center\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">            \n            <div class=\"col-12\" mbr-if=\"showTitle\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-2\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>Thông tin liên hệ</b></h3>\n                <h4 class=\"mbr-section-subtitle mb-0 mb-4 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\">\n                       Chúng tôi sẽ liên hệ lại trong vòng 24h</h4>\n            </div>\n            <div class=\"col-lg-8 mx-auto mbr-form\">\n\n                  <form class=\"mbr-form anphabe-lead form-with-styler  needs-validation\" novalidate data-form-type=\"anphabe-lead\" name=\"Form Name\" method=\"POST\">      \n                                  <input type=\"hidden\" id=\"product_name-form7-44\" name=\"product_name\" data-form-field=\"product_name\" value=\"business\">\n                                  <input type=\"hidden\" name=\"landingpage\" value=\"business-contact\">\n                    <input type=\"hidden\" id=\"utm_campaign-form7-44\" name=\"utm_campaign\" data-form-field=\"utm_campaign\" value>\n                    <input type=\"hidden\" id=\"utm_source-form7-44\" name=\"utm_source\" data-form-field=\"utm_source\" value>\n                    <input type=\"hidden\" id=\"utm_medium-form7-44\" name=\"utm_medium\" data-form-field=\"utm_medium\" value>\n                    <input type=\"hidden\" id=\"utm_term-form7-44\" name=\"utm_term\" data-form-field=\"utm_term\" value>\n                    <input type=\"hidden\" id=\"utm_content-form7-44\" name=\"utm_content\" data-form-field=\"utm_content\" value>\n                    <a id=\"destination\" href=\"thankyou.html\" style=\"display:none;\"></a>\n                                  <div class=\"dragArea row\">\n    