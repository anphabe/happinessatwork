            ".widget-content p": {
              "margin-bottom": "0"
            },
            ".nav-link::after": {
              "color": "inherit !important",
              "transform": "rotate(0)",
              "transition": ".3s"
            },
            ".nav-item .nav-link::before": {
              "content": "''",
              "position": "absolute",
              "bottom": "0",
              "left": "0",
              "width": "0",
              "height": "2px",
              "color": "#004a77",
              "background-color": "#ffc000  ",
              "transition": "all 0.3s ease-in-out"
            },
            ".nav-item .nav-link:hover, .nav-item .nav-link:focus": {
