4-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334\"></path>\n                            </svg>\n                          </a>\n                          <a class=\"pr-1\" href=\"https://www.tiktok.com/@growwithaeon\" target=\"_blank\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 512 512\">\n                            <path fill=\"#000000\" d=\"M448 209.9a210.1 210.1 0 0 1 -122.8-39.3V349.4A162.6 162.6 0 1 1 185 188.3V278.2a74.6 74.6 0 1 0 52.2 71.2V0l88 0a121.2 121.2 0 0 0 1.9 22.2h0A122.2 122.2 0 0 0 381 102.4a121.4 121.4 0 0 0 67 20.1z\"></path></svg>\n                          </a>-->\n                        </div>\n                        \n                    </div>\n                </div>\n            </div>\n        </div>\n        <hr>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_isUserblock": true,
          "_cid": "v7AlFJpGpy",
          "_anchor": "features15-et",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".text-wrapper": {
                "padding": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".image-wrapper": {
                "margin-bottom": "1rem"
              }
            },
            "img": {
              "width": "50%",
              "margin": "0 auto"
            },
            ".mbr-section-title": {
              "text-align": "left"
            },
            ".progress-container": {
              "width": "100%",
              "background-color": "#f0f0f0",
              "border-radius": "10px",
              "overflow": "hidden",
              "margin": "20px 0"
            },
            ".label": {
              "padding-left": "15px",
              "font-weight": "bold"
            },
            ".progress-circle1": {
              "transition": "background 1.5s linear",
              "background": "conic-gradient(#ffc000 84%, #eeeeee 16%)"
            },
            ".progress-circle2": {
              "transition": "background 1.5s linear",
              "background": "conic-gradient(#ffc720 84%, #eeeeee 16%)"
            },
            ".progress-circle3": {
              "transition": "background 1.5s linear",
              "background": "conic-gradient(#fcd04c 83%, #eeeeee 17%)"
            },
            ".circle-style": {
              "width": "220px",
              "height": "220px",
              "border-radius": "50%",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "position": "relative"
            },
            ".circle-style::before": {
              "content": "''",
              "position": "absolute",
              "width": "80%",
              "height": "80%",
              "background": "white",
              "border-radius": "50%"
            },
            ".circle-style span": {
              "position": "relative",
              "font-size": "2em",
              "font-weight": "bold"
            },
            "@keyframes progress-animation": {
              "from": {
                "background": "conic-gradient(#ffc000 0%, #eeeeee 100%)"
              },
              "to": {
                "background": "conic-gradient(#ffc000 83%, #eeeeee 17%)"
              }
            },
            ".mbr-description": {
              "text-align": "center"
            },
            "@media (max-width: 768px)": {
              "padding-bottom": "(@paddingBottom * 0.5rem)"
            },
            "ol": {
              "margin": "0",
              "padding-left": "1rem"
            },
            "li": {
              "position": "relative",
              "margin-bottom": "1rem",
              "padding-left": "1rem"
            }
          },
          "_name": "image1",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"image1\" group=\"Images & Videos\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" name=\"textWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDescription\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/badge-1.png\" alt=\"Mobirise Website Builder\">\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-8\">\n                <div class=\"text-wrapper\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Giới thiệu doanh nghiệp</b></h3>\n                   <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">MTI Technology được thành lập năm 2016 - thành viên của Tập đoàn MTI, đánh dấu hành trình phát triển bền vững trong lĩnh vực công nghệ cho thị trường Nhật Bản. Từ khởi đầu khiêm tốn với 20 nhân sự, MTI Technology đã mở rộng lên hơn 185 thành viên tài năng và tiếp tục tăng trưởng mạnh mẽ.   </p>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Với phương pháp Agile, MTI tập trung tạo ra sản phẩm tối ưu trong thời gian hiệu quả nhất, đảm bảo hài hòa giữa chất lượng, tính khả thi và sự tiện lợi. Triết lý này được thể hiện trong từng giải pháp mà MTI mang đến cho khách hàng và cộng đồng.  </p>\n\n                    <h3 class=\"mbr-section-title mbr-fonts-style align-center mt-4 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>Định hướng chiến lược xây dựng nguồn nhân lực hạnh phúc</b></h3>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Tại MTI Technology, tư duy chiến lược trong việc xây dựng môi trường và đội ngũ nhân lực hạnh phúc được định hướng xoay quanh 9 giá trị cốt lõi:  </p>\n                    <ol class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list\" data-multiline mbr-article>\n                        <li><b>Professional</b> - <b>Chuyên nghiệp</b>: Đề cao sự chuyên nghiệp trong tư duy, hành động và cách làm việc.</li>\n                        <li><b>Contribution</b> - <b>Cống hiến</b>: Mỗi cá nhân đều được khuyến khích đóng góp giá trị thật cho tập thể.</li>\n                        <li><b>Challenge </b>- <b>Thử thách</b>: Tạo điều kiện để nhân viên vượt qua giới hạn và đón nhận thử thách mới.</li>\n                        <li><b>Kaizen </b>-<b> Cải tiến liên tục</b>: Không ngừng học hỏi và hoàn thiện quy trình, kỹ năng, và bản thân.</li>\n                        <li><b>Respect</b> - <b>Tôn trọng</b>: Tôn trọng sự khác biệt, vai trò và đóng góp của mỗi thành viên.</li>\n                        <li><b>Teamwork</b> - <b>Làm việc nhóm</b>: Sức mạnh tập thể là chìa khóa giúp tổ chức phát triển bền vững.</li>\n                        <li><b>Communication</b> - <b>Giao tiếp hiệu quả</b>: Duy trì môi trường giao tiếp cởi mở, minh bạch và xây dựng.</li>\n                        <li><b>Growth</b> - <b>Phát triển</b>: Đồng hành cùng nhân viên trong hành trình phát triển cá nhân và sự nghiệp.</li>\n                        <li><b>Satisfaction</b> - <b>Hài lòng</b>: Đảm bảo sự hài lòng không chỉ trong công việc mà còn trong hành trình gắn bó lâu dài.</li>\n                    </ol>\n                    \n                    <div class=\"row chart-info\">\n                        <div class=\"col-12 col-lg-4 mb-3 mt-4\">\n                            <div class=\"item-wrapper d-flex justify-content-center\">\n                                <div class=\"circle-style progress-circle1 item-wrapper\" data-circle=\"84\" data-color=\"#ffc000\">\n                                    <span data-counter=\"84\" data-start=\"0\" class=\"mbr-description mbr-fonts-style\" mbr-theme-style=\"display-7\">84%</span>\n                                </div>\n                            </div>                 \n                            <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-description\"><b>Tôi được tạo đủ cơ hội để kế hoạch nghề nghiệp thành hiện thực</b></p>\n                        </div>\n\n                        <div class=\"col-12 col-lg-4 mb-3 mt-4\">\n                            <div class=\"item-wrapper d-flex justify-content-center\">\n                                <div class=\"circle-style progress-circle2 item-wrapper\" data-circle=\"84\" data-color=\"#ffc720\">\n                                    <span data-counter=\"84\" data-start=\"0\" class=\"mbr-description mbr-fonts-style\" mbr-theme-style=\"display-7\">84%</span>\n                                </div>\n                            </div>                 \n                            <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-description\"><b>Tôi được tạo đủ cơ hội để kế hoạch nghề nghiệp thành hiện thực</b></p>\n                        </div>\n\n                        <div class=\"col-12 col-lg-4 mb-3 mt-4\">\n                            <div class=\"item-wrapper d-flex justify-content-center\">\n                                <div class=\"circle-style progress-circle3 item-wrapper\" data-circle=\"83\" data-color=\"#fcd04c\">\n                                    <span data-counter=\"83\" data-start=\"0\" class=\"mbr-description mbr-fonts-style\" mbr-theme-style=\"display-7\">83%</span>\n                                </div>\n                            </div>                 \n                            <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-description\"><b>Tôi có thể chia sẻ những điểm hấp dẫn của công ty dưới góc độ nơi làm việc tốt</b></p>\n                        </div>\n                    </div>\n                \n                </div>\n            </div>        \n            \n        </div>\n    </div>\n\n\n    \n    <!--[JS_CODE_0]-->\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [
            "<script>\n        const ease = {\n        linear: t => t,\n        inOutQuad: t => t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t,\n        };\n\n        const animateCircle = (circle, targetValue, color) => {\n        const duration = 1500;\n        let startValue = 0;\n        const startTime = Date.now();\n\n        const updateCircle = () => {\n            const elapsedTime = Date.now() - startTime;\n            const progress = Math.min(elapsedTime / duration, 1);\n            const easedProgress = ease.inOutQuad(progress);\n            const currentValue = Math.round(startValue + easedProgress * (targetValue - startValue));\n            \n            const startAngle = 0;\n            const endAngle = currentValue * 3.6; // 1% = 3.6 degrees\n\n            circle.querySelector('span').textContent = `${currentValue}%`;\n            circle.style.background = `conic-gradient(${color} ${startAngle}deg ${endAngle}deg, #eeeeee ${endAngle}deg 360deg)`;\n\n            if (progress < 1) {\n            requestAnimationFrame(updateCircle);\n            }\n        };\n\n        requestAnimationFrame(updateCircle);\n        };\n\n        const counter = (EL) => {\n        const endValue = parseInt(EL.dataset.counter, 10);\n        const color = EL.parentElement.getAttribute('data-color');\n        animateCircle(EL.parentElement, endValue, color);\n        };\n\n        const observerOptions = {\n        root: null,\n        rootMargin: '0px',\n        threshold: 0.1 // Trigger when at least 10% of the element is visible\n        };\n\n        const observerCallback = (entries, observer) => {\n        entries.forEach(entry => {\n            if (entry.isIntersecting) {\n            counter(entry.target);\n            observer.unobserve(entry.target); // Stop observing once the animation has started\n            }\n        });\n        };\n\n        const observer = new IntersectionObserver(observerCallback, observerOptions);\n\n        document.querySelectorAll(\"[data-counter]\").forEach(el => {\n        observer.observe(el);\n        });\n    </script>"
          ],
