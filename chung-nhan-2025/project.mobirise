              },
              ".text-content": {
                "text-align": "left"
              },
              ".text-content-left": {
                "padding-bottom": "1rem"
              }
            },
            "H5": {
              "text-align": "left"
            },
            "a[class*=\"text-\"]:not(.nav-link):not(.dropdown-item):not([role]):not(.navbar-caption):hover": {
              "background-image": "none"
            },
            ".copyright-style, .copyright": {
              "font-size": "0.8rem!important"
            }
