          "_name": "features15",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features15\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Color\" name=\"iconColor\" value=\"#6592e6\" selected condition=\"showIcon\">\n        <select title=\"Columns\" name=\"columns\">\n            <option value=\"3\">4</option>\n            <option value=\"4\" selected>3</option>\n            <option value=\"6\">2</option>\n            <option value=\"12\">1</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <hr>\n        <div class=\"row justify-content-center\">\n            <div class=\"item features-without-image col-12 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title mbr-fonts-style mb-2\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>QUY MÔ</b></h4>\n                        <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">1.000 - 4.999 nhân viên</h5>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title mbr-fonts-style mb-2\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>NGÀNH</b></h4>\n                        <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Điện tử / Công nghệ cao / Thiết bị phụ trợ / Bán lẻ / Bán sỉ / Thương mại</h5>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title mbr-fonts-style mb-2\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            <b>TÌM HIỂU THÊM VỀ DOANH NGHIỆP</b></h4>\n                        <div>\n                          <a class=\"pr-1\" href=\"https://vieclam.vinhkhangmobile.vn/\" target=\"_blank\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" fill=\"#146ebe\" viewBox=\"0 0 512 512\"><!--!Font Awesome Free 6.5.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path d=\"M352 256c0 22.2-1.2 43.6-3.3 64H163.3c-2.2-20.4-3.3-41.8-3.3-64s1.2-43.6 3.3-64H348.7c2.2 20.4 3.3 41.8 3.3 64zm28.8-64H503.9c5.3 20.5 8.1 41.9 8.1 64s-2.8 43.5-8.1 64H380.8c2.1-20.6 3.2-42 3.2-64s-1.1-43.4-3.2-64zm112.6-32H376.7c-10-63.9-29.8-117.4-55.3-151.6c78.3 20.7 142 77.5 171.9 151.6zm-149.1 0H167.7c6.1-36.4 15.5-68.6 27-94.7c10.5-23.6 22.2-40.7 33.5-51.5C239.4 3.2 248.7 0 256 0s16.6 3.2 27.8 13.8c11.3 10.8 23 27.9 33.5 51.5c11.6 26 20.9 58.2 27 94.7zm-209 0H18.6C48.6 85.9 112.2 29.1 190.6 8.4C165.1 42.6 145.3 96.1 135.3 160zM8.1 192H131.2c-2.1 20.6-3.2 42-3.2 64s1.1 43.4 3.2 64H8.1C2.8 299.5 0 278.1 0 256s2.8-43.5 8.1-64zM194.7 446.6c-11.6-26-20.9-58.2-27-94.6H344.3c-6.1 36.4-15.5 68.6-27 94.6c-10.5 23.6-22.2 40.7-33.5 51.5C272.6 508.8 263.3 512 256 512s-16.6-3.2-27.8-13.8c-11.3-10.8-23-27.9-33.5-51.5zM135.3 352c10 63.9 29.8 117.4 55.3 151.6C112.2 482.9 48.6 426.1 18.6 352H135.3zm358.1 0c-30 74.1-93.6 130.9-171.9 151.6c25.5-34.2 45.2-87.7 55.3-151.6H493.4z\"></path></svg>\n                          </a> \n                          <a class=\"pr-1\" href=\"https://www.linkedin.com/company/oppo/\" target=\"_blank\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" fill=\"currentColor\" class=\"bi bi-linkedin\" viewBox=\"0 0 16 16\">\n                              <path d=\"M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z\"></path>\n                            </svg>\n                          </a>                        \n                          <a class=\"pr-1\" href=\"https://www.facebook.com/oppovn.jobs/\" target=\"_blank\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" fill=\"#1778f2\" class=\"bi bi-facebook\" viewBox=\"0 0 16 16\">\n                              <path d=\"M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951\"></path>\n                            </svg>\n                          </a>\n                          \n                          <!--<a class=\"pr-1\" href=\"https://www.youtube.com/@f88vietnam\" target=\"_blank\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" fill=\"#dc3545\" class=\"bi bi-youtube\" viewBox=\"0 0 16 16\">\n                              <path d=\"M8.051 1.999h.089c.822.003 4.987.033 6.11.335a2.01 2.01 0 0 1 1.415 1.42c.101.38.172.883.22 1.402l.01.104.022.26.008.104c.065.914.073 1.77.074 1.957v.075c-.001.194-.01 1.108-.082 2.06l-.008.105-.009.104c-.05.572-.124 1.14-.235 1.558a2.01 2.01 0 0 1-1.415 1.42c-1.16.312-5.569.334-6.18.335h-.142c-.309 0-1.587-.006-2.927-.052l-.17-.006-.087-.004-.171-.007-.171-.007c-1.11-.049-2.167-.128-2.654-.26a2.01 2.01 0 0 1-1.415-1.419c-.111-.417-.185-.986-.235-1.558L.09 9.82l-.008-.104A31 31 0 0 1 0 7.68v-.123c.002-.215.01-.958.064-1.778l.007-.103.003-.052.008-.104.022-.26.01-.104c.048-.519.119-1.023.22-1.402a2.01 2.01 0 0 1 1.415-1.42c.487-.13 1.544-.21 2.654-.26l.17-.007.172-.006.086-.003.171-.007A100 100 0 0 1 7.858 2zM6.4 5.209v4.818l4.157-2.408z\"></path>                   \n                            </svg>\n                          </a>\n                          <a class=\"pr-1\" href=\"https://www.instagram.com/aeonvn.lifestyle/\" target=\"_blank\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" fill=\"#f00075\" class=\"bi bi-instagram\" viewBox=\"0 0 16 16\">\n                              <path d=\"M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334\"></path>\n                            </svg>\n                          </a>\n                          <a class=\"pr-1\" href=\"https://www.tiktok.com/@growwithaeon\" target=\"_blank\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 512 512\">\n                            <path fill=\"#000000\" d=\"M448 209.9a210.1 210.1 0 0 1 -122.8-39.3V349.4A162.6 162.6 0 1 1 185 188.3V278.2a74.6 74.6 0 1 0 52.2 71.2V0l88 0a121.2 121.2 0 0 0 1.9 22.2h0A122.2 122.2 0 0 0 381 102.4a121.4 121.4 0 0 0 67 20.1z\"></path></svg>\n                          </a>-->\n                        </div>\n                        \n                    </div>\n                </div>\n            </div>\n        </div>\n        <hr>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_isUserblock": true,
          "_cid": "v7AGi1beug",
          "_anchor": "features15-fu",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".text-wrapper": {
                "padding": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".image-wrapper": {
                "margin-bottom": "1rem"
              }
            },
            "img": {
              "width": "50%",
              "margin": "0 auto"
            },
            ".mbr-section-title": {
              "text-align": "left"
            },
            ".progress-container": {
              "width": "100%",
              "background-color": "#f0f0f0",
              "border-radius": "10px",
              "overflow": "hidden",
              "margin": "20px 0"
            },
            ".label": {
              "padding-left": "15px",
              "font-weight": "bold"
            },
            ".progress-circle1": {
              "transition": "background 1.5s linear",
              "background": "conic-gradient(#ffc000 91%, #eeeeee 9%)"
            },
            ".progress-circle2": {
              "transition": "background 1.5s linear",
              "background": "conic-gradient(#ffc720 90%, #eeeeee 10%)"
            },
            ".progress-circle3": {
              "transition": "background 1.5s linear",
              "background": "conic-gradient(#fcd04c 90%, #eeeeee 10%)"
            },
            ".circle-style": {
              "width": "220px",
              "height": "220px",
              "border-radius": "50%",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "position": "relative"
            },
            ".circle-style::before": {
              "content": "''",
              "position": "absolute",
              "width": "80%",
              "height": "80%",
              "background": "white",
              "border-radius": "50%"
            },
            ".circle-style span": {
              "position": "relative",
              "font-size": "2em",
              "font-weight": "bold"
            },
            "@keyframes progress-animation": {
              "from": {
                "background": "conic-gradient(#ffc000 0%, #eeeeee 100%)"
              },
              "to": {
                "background": "conic-gradient(#ffc000 83%, #eeeeee 17%)"
              }
            },
            ".mbr-description": {
              "text-align": "center"
            },
            "@media (max-width: 768px)": {
              "padding-bottom": "(@paddingBottom * 0.5rem)"
            },
            "ol": {
              "margin": "0",
              "padding-left": "1rem"
            },
            "li": {
              "position": "relative",
              "margin-bottom": "1rem",
              "padding-left": "1rem"
            }
          },
          "_name": "image1",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"image1\" group=\"Images & Videos\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" name=\"textWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDescription\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/badge-1.png\" alt=\"Mobirise Website Builder\">\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-8\">\n                <div class=\"text-wrapper\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Giới thiệu doanh nghiệp</b></h3>\n                   <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">OPPO là thương hiệu công nghệ toàn cầu, tiên phong mang đến những sản phẩm và dịch vụ thông minh với thiết kế tối giản tinh tế cùng trải nghiệm vượt trội. OPPO không ngừng truyền cảm hứng, giúp người dùng dễ dàng sáng tạo và tận hưởng trọn vẹn niềm vui từ những công nghệ tiên tiến nhất.   </p>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Với OPPO, “Bổn phận” là giá trị cốt lõi và là niềm tin bất biến; đặt người dùng làm trung tâm là nguyên tắc không thể lay chuyển; và đam mê sáng tạo là động lực vô tận của chúng tôi. Chúng tôi tiên phong nâng tầm công nghệ thông minh cá nhân, giúp mọi người khám phá và tạo dựng vẻ đẹp của cuộc sống, có được sự viên mãn và tự do trong đời.  </p>\n\n                    <h3 class=\"mbr-section-title mbr-fonts-style align-center mt-4 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>Định hướng chiến lược xây dựng nguồn nhân lực hạnh phúc</b></h3>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\"Công nghệ vì Con người - Tử tế vì Thế giới\" là động lực thúc đẩy sự đổi mới và phát triển công nghệ của OPPO. Nói cách khác, chúng tôi cam kết hỗ trợ mọi cá nhân có tinh thần đổi mới phát triển, cũng như thúc đẩy sự phát triển xã hội nói chung, đồng thời theo đuổi văn hoá BenFen - Bổn phận giúp con người xây dựng một xã hội hoà hợp và cùng phát triển  </p>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Văn hoá doanh nghiệp cốt lõi là \"Bổn phận\". Chúng tôi cam kết tạo ra những sản phẩm tuyệt vời, làm hài lòng người dùng. Đối mặt với áp lực và sự cám dỗ từ bên ngoài, chúng tôi tin rằng việc giữ bình tĩnh và tập trung vào các nguyên tắc cơ bản là cách duy nhất để đưa ra những nhận định và lựa chọn đúng đắn, mở đường cho sự phát triển mạnh mẽ và bền vững cho doanh nghiệp.</p>\n                    \n                    \n                    <div class=\"row chart-info\">\n                        <div class=\"col-12 col-lg-4 mb-3 mt-4\">\n                            <div class=\"item-wrapper d-flex justify-content-center\">\n                                <div class=\"circle-style progress-circle1 item-wrapper\" data-circle=\"91\" data-color=\"#ffc000\">\n                                    <span data-counter=\"91\" data-start=\"0\" class=\"mbr-description mbr-fonts-style\" mbr-theme-style=\"display-7\">91%</span>\n                                </div>\n                            </div>                 \n                            <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-description\"><b>Tôi tự hào khi là một thành viên của công ty</b></p>\n                        </div>\n\n                        <div class=\"col-12 col-lg-4 mb-3 mt-4\">\n                            <div class=\"item-wrapper d-flex justify-content-center\">\n                                <div class=\"circle-style progress-circle2 item-wrapper\" data-circle=\"90\" data-color=\"#ffc720\">\n                                    <span data-counter=\"90\" data-start=\"0\" class=\"mbr-description mbr-fonts-style\" mbr-theme-style=\"display-7\">90%</span>\n                                </div>\n                            </div>                 \n                            <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-description\"><b>Tôi không ngại làm nhiều hơn mức yêu cầu để giúp công ty thành công</b></p>\n                        </div>\n\n                        <div class=\"col-12 col-lg-4 mb-3 mt-4\">\n                            <div class=\"item-wrapper d-flex justify-content-center\">\n                                <div class=\"circle-style progress-circle3 item-wrapper\" data-circle=\"90\" data-color=\"#fcd04c\">\n                                    <span data-counter=\"90\" data-start=\"0\" class=\"mbr-description mbr-fonts-style\" mbr-theme-style=\"display-7\">90%</span>\n                                </div>\n                            </div>                 \n                            <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-description\"><b>Tôi có thể chia sẻ những điểm hấp dẫn của công ty dưới góc độ nơi làm việc tốt</b></p>\n                        </div>\n                    </div>\n                \n                </div>\n            </div>        \n            \n        </div>\n    </div>\n\n\n    \n    <!--[JS_CODE_0]-->\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [
            "<script>\n        const ease = {\n        linear: t => t,\n        inOutQuad: t => t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t,\n        };\n\n        const animateCircle = (circle, targetValue, color) => {\n        const duration = 1500;\n        let startValue = 0;\n        const startTime = Date.now();\n\n        const updateCircle = () => {\n            const elapsedTime = Date.now() - startTime;\n            const progress = Math.min(elapsedTime / duration, 1);\n            const easedProgress = ease.inOutQuad(progress);\n            const currentValue = Math.round(startValue + easedProgress * (targetValue - startValue));\n            \n            const startAngle = 0;\n            const endAngle = currentValue * 3.6; // 1% = 3.6 degrees\n\n            circle.querySelector('span').textContent = `${currentValue}%`;\n            circle.style.background = `conic-gradient(${color} ${startAngle}deg ${endAngle}deg, #eeeeee ${endAngle}deg 360deg)`;\n\n            if (progress < 1) {\n            requestAnimationFrame(updateCircle);\n            }\n        };\n\n        requestAnimationFrame(updateCircle);\n        };\n\n        const counter = (EL) => {\n        const endValue = parseInt(EL.dataset.counter, 10);\n        const color = EL.parentElement.getAttribute('data-color');\n        animateCircle(EL.parentElement, endValue, color);\n        };\n\n        const observerOptions = {\n        root: null,\n        rootMargin: '0px',\n        threshold: 0.1 // Trigger when at least 10% of the element is visible\n        };\n\n        const observerCallback = (entries, observer) => {\n        entries.forEach(entry => {\n            if (entry.isIntersecting) {\n            counter(entry.target);\n            observer.unobserve(entry.target); // Stop observing once the animation has started\n            }\n        });\n        };\n\n        const observer = new IntersectionObserver(observerCallback, observerOptions);\n\n        document.querySelectorAll(\"[data-counter]\").forEach(el => {\n        observer.observe(el);\n        });\n    </script>"
          ],
