            ".info-widget": {
              "margin-left": "30px",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center"
            },
            ".navbar.navbar-short .navbar-brand": {
              "min-height": "60px",
              "padding": "0"
            },
            ".widget-icon": {
              "color": "#e9e9e9",
              "display": "inline-block",
              "padding-right": "0.5rem",
              "font-size": "1rem",
              "font-weight": "bold"
            },
            ".info-widget .display-4": {
