        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "img, .item-img": {
              "& when (@autoSize)": {
                "height": "100%",
                "object-fit": "cover",
                "& when (@showCardTitle)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                },
                "& when (@showCardSubtitle)": {
                  "height": "(@imageHeight * 1050px)",
                  "object-fit": "cover"
                },
                "& when (@showText)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                },
                "& when (@showButtons)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                }
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item": {
              "cursor": "pointer",
              "margin-bottom": "2rem"
            },
            "& when not (@spacing)": {
              ".row": {
                "margin-left": "0",
                "margin-right": "0"
              },
              ".item": {
                "padding": "0",
                "margin": "0"
              }
            },
            ".item-wrapper": {
              "position": "relative",
              "border-radius": "4px",
              "background": "@cardsBg",
              "height": "100%",
              "display": "flex",
              "flex-flow": "column nowrap",
              "@media (min-width: 992px)": {
                "& when (@showButtons)": {
                  ".item-content": {
                    "padding": "2rem 2rem 0"
                  },
                  ".item-footer": {
                    "padding": "0 2rem 2rem"
                  }
                },
                "& when not (@showButtons)": {
                  ".item-content": {
                    "padding": "2rem 2rem 0"
                  }
                }
              },
              "@media (max-width: 991px)": {
                "& when (@showButtons)": {
                  ".item-content": {
                    "padding": "1rem 1rem 0"
                  },
                  ".item-footer": {
                    "padding": "0 1rem 1rem"
                  }
                },
                "& when not (@showButtons)": {
                  ".item-content": {
                    "padding": "1rem"
                  }
                }
              }
            },
            ".mbr-section-btn": {
              "margin-top": "auto !important"
            },
            ".mbr-section-title": {
              "color": "#232323"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "left"
            },
            ".item-title": {
              "text-align": "left",
              "color": "#9d9b9b"
            },
            ".item-subtitle": {
              "text-align": "left",
              "color": "#232323"
            },
            "h6 a.text-title:link, h6 a.text-title:visited, h6 a.text-title:hover": {
              "background-image": "none!important",
              "color": "#232323!important",
              "font-weight": "bold!important",
              "text-decoration": "none!important"
            },
            "a.text-primary": {
              "font-weight": "bold!important"
            }
          },
          "_name": "content3",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content3\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <select title=\"Columns\" name=\"cardsWidth\">\n            <option value=\"12\">1</option>\n            <option value=\"6\">2</option>\n            <option value=\"4\" selected>3</option>\n            <option value=\"3\">4</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\">\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\">\n        <header>Cards</header>\n        <input type=\"checkbox\" name=\"autoSize\" title=\"Auto Size\" checked>\n        <input type=\"range\" name=\"imageHeight\" title=\"Height\" min=\"1\" max=\"5\" step=\"1\" value=\"3\" condition=\"autoSize && !(showButtons==false && showCardSubtitle==false && showCardTitle==false && showText==false)\">\n        <input type=\"checkbox\" title=\"Spacing\" name=\"spacing\" checked>\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showCardSubtitle\" title=\"Subtitle\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked>\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\">\n        <input type=\"color\" name=\"cardsBg\" title=\"BG\" value=\"#fafafa\">\n        <input type=\"checkbox\" title=\"Link\" name=\"showLink\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>Our News</b></h4>\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-2\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Read the latest news about Mobirise</h5>\n        </div>\n        <div class=\"row mt-2\">\n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"aeon-vietnam.html\"><img src=\"@PROJECT_PATH@/assets/images/aeon.jpg\" alt=\"Công ty TNHH AEON Việt Nam\" title></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">                        \n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-5\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><b><a href=\"aeon-vietnam.html\" class=\"text-primary text-title\">AEON VIỆT NAM</a></b></h6>\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><i>Bán lẻ / Bán sỉ / Thương mại</i></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">AEON Việt Nam, thành lập năm 2011, phát triển 5 lĩnh vực bán lẻ tại 6 tỉnh thành, với 6000 nhân viên, hướng đến cuộc sống bền vững và thịnh vượng.</p>\n                        <div class=\"link-wrap mb-4\">\n                            <h6 class=\"link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showLink\" data-app-selector=\".link\">\n                                <a href=\"aeon-vietnam.html\" class=\"text-primary\"></a><a href=\"aeon-vietnam.html\" class=\"text-primary\">Tìm hiểu thêm </a><span style=\"font-size: 1.4rem; vertical-align: middle\"><a href=\"aeon-vietnam.html\" class=\"text-primary\">➝</a></span>\n                            </h6>\n                        </div>\n                    </div>                    \n                </div>\n            </div>\n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"bitis.html\"><img src=\"@PROJECT_PATH@/assets/images/bitis.jpg\" alt=\"BITI'S\" title></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">                        \n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-5\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><b><a href=\"bitis.html\" class=\"text-primary text-title\">BITI'S</a></b></h6>\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><i>Sản xuất / Bán lẻ / Bán sỉ / Thương mại</i></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">Hơn 40 năm tại Việt Nam, hệ thống gần 200 cửa hàng tiếp thị, phục vụ 30 triệu khách hàng trong nước và quốc tế đa dạng phân khúc từ trẻ em đến người lớn.</p>\n                        <div class=\"link-wrap mb-4\">\n                            <h6 class=\"link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showLink\" data-app-selector=\".link\">\n                                <a href=\"bidv.html\" class=\"text-primary\"></a><a href=\"bitis.html\" class=\"text-primary\">Tìm hiểu thêm </a><span style=\"font-size: 1.4rem; vertical-align: middle\"><a href=\"bitis.html\" class=\"text-primary\">➝</a></span>\n                            </h6>\n                        </div>\n                    </div>                    \n                </div>\n            </div>\n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"capitaland.html\"><img src=\"@PROJECT_PATH@/assets/images/capitaland.jpg\" alt=\"CAPITALAND DEVELOPMENT (VIỆT NAM)\" title></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">                        \n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-5\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><b><a href=\"capitaland.html\" class=\"text-primary text-title\">CAPITALAND DEVELOPMENT (VIỆT NAM)</a></b></h6>\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><i>Bất động sản/ Dịch vụ bất động sản</i></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">CapitaLand Development (CLD) là nhánh bất động sản của CapitaLand, phát triển đa dạng tài sản, ưu tiên bền vững và phúc lợi xã hội tại Việt Nam.</p>\n                        <div class=\"link-wrap mb-4\">\n                            <h6 class=\"link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showLink\" data-app-selector=\".link\">\n                                <a href=\"capitaland.html\" class=\"text-primary\"></a><a href=\"capitaland.html\" class=\"text-primary\">Tìm hiểu thêm </a><span style=\"font-size: 1.4rem; vertical-align: middle\"><a href=\"capitaland.html\" class=\"text-primary\">➝</a></span>\n                            </h6>\n                        </div>\n                    </div>                    \n                </div>\n            </div>\n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"newvietdairy.html\"><img src=\"@PROJECT_PATH@/assets/images/newvietdairy.jpg\" alt=\"NEW VIET DAIRY\" title></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">                        \n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-5\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><b><a href=\"newvietdairy.html\" class=\"text-primary text-title\">NEW VIET DAIRY</a></b></h6>\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><i>Hàng tiêu dùng / Bán lẻ / Bán sỉ / Thương mại</i></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">Thành lập từ 1997, là nhà nhập khẩu và phân phối nguyên liệu thực phẩm hàng đầu tại Việt Nam, chất lượng cao từ các nhà cung cấp uy tín trên thế giới.</p>\n                        <div class=\"link-wrap mb-4\">\n                            <h6 class=\"link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showLink\" data-app-selector=\".link\">\n                                <a href=\"fwd-vietnam.html\" class=\"text-primary\"></a><a href=\"newvietdairy.html\" class=\"text-primary\">Tìm hiểu thêm </a><span style=\"font-size: 1.4rem; vertical-align: middle\"><a href=\"fwd.html\" class=\"text-primary\">➝</a></span>\n                            </h6>\n                        </div>\n                    </div>                    \n                </div>\n            </div>\n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"davipharm.html\"><img src=\"@PROJECT_PATH@/assets/images/davipharm.jpg\" alt=\"DAVIPHARM\" title></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">                        \n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-5\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><a href=\"davipharm.html\" class=\"text-primary text-title\">DAVIPHARM</a></h6>\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><i>Dược / Thiết bị y tế / Chăm sóc sức khỏe&nbsp;</i></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">Thành lập 2004, là nhà sản xuất thuốc chất lượng cao hàng đầu Việt Nam, đạt chuẩn WHO-GMP, vận hành dây chuyền HP Zone, đạt chứng nhận EU-GMP.</p>\n                        <div class=\"link-wrap mb-4\">\n                            <h6 class=\"link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showLink\" data-app-selector=\".link\">\n                                <a href=\"goertek.html\" class=\"text-primary\"></a><a href=\"davipharm.html\" class=\"text-primary\">Tìm hiểu thêm </a><span style=\"font-size: 1.4rem; vertical-align: middle\"><a href=\"goertekvn.html\" class=\"text-primary\">➝</a></span>\n                            </h6>\n                        </div>\n                    </div>                    \n                </div>\n            </div>\n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"f88.html\"><img src=\"@PROJECT_PATH@/assets/images/f88.jpg\" alt=\"F88\" title></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">                        \n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-5\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><a href=\"f88.html\" class=\"text-primary text-title\">F88</a></h6>\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><i>Dịch vụ tài chính&nbsp;</i></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">F88 cung cấp các giải pháp tài chính nhanh và dễ tiếp cận cho người dân đại chúng,\n<br>hỗ trợ thanh toán hóa đơn và nhiều dịch vụ tài chính thiết yếu khác.</p>\n                        <div class=\"link-wrap mb-4\">\n                            <h6 class=\"link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showLink\" data-app-selector=\".link\">\n                                <a href=\"home-credit.html\" class=\"text-primary\"></a><a href=\"f88.html\" class=\"text-primary\">Tìm hiểu thêm </a><span style=\"font-size: 1.4rem; vertical-align: middle\"><a href=\"homecredit.html\" class=\"text-primary\">➝</a></span>\n                            </h6>\n                        </div>\n                    </div>                    \n                </div>\n            </div>\n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"vietcombank.html\"><img src=\"@PROJECT_PATH@/assets/images/vietcombank.jpg\" alt=\"VIETCOMBANK\" title></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">                        \n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-5\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><a href=\"vietcombank.html\" class=\"text-primary text-title\">VIETCOMBANK</a></h6>\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><i>Ngân hàng</i></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">Vietcombank thành lập 1963, đóng góp quan trọng cho sự ổn định và phát triển của kinh tế, tạo ảnh hưởng quan trọng trong cộng đồng tài chính Việt Nam.</p>\n                        <div class=\"link-wrap mb-4\">\n                            <h6 class=\"link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showLink\" data-app-selector=\".link\">\n                                <a href=\"mb.html\" class=\"text-primary\"></a><a href=\"vietcombank.html\" class=\"text-primary\">Tìm hiểu thêm </a><span style=\"font-size: 1.4rem; vertical-align: middle\"><a href=\"mbbank.html\" class=\"text-primary\">➝</a></span>\n                            </h6>\n                        </div>\n                    </div>                    \n                </div>\n            </div>\n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"mti.html\"><img src=\"@PROJECT_PATH@/assets/images/miti.jpg\" alt=\"MTI TECHNOLOGY CO., LTD\" title></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">                        \n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-5\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><b><a href=\"mti.html\" class=\"text-primary text-title\">MTI TECHNOLOGY CO., LTD</a></b></h6>\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><i>Công nghệ thông tin / Phần mềm &amp; Ứng dụng / Thương mại điện tử</i></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">MTI Technology thành lập năm 2016, đánh dấu hành trình phát triển bền vững trong lĩnh vực công nghệ cho thị trường Nhật Bản,  có sự tăng trưởng mạnh mẽ.</p>\n                        <div class=\"link-wrap mb-4\">\n                            <h6 class=\"link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showLink\" data-app-selector=\".link\">\n                                <a href=\"mm-mega-market.html\" class=\"text-primary\"></a><a href=\"mti.html\" class=\"text-primary\">Tìm hiểu thêm </a><span style=\"font-size: 1.4rem; vertical-align: middle\"><a href=\"mmvietnam.html\" class=\"text-primary\">➝</a></span>\n                            </h6>\n                        </div>\n                    </div>                    \n                </div>\n            </div>\n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"oppo.html\"><img src=\"@PROJECT_PATH@/assets/images/oppo.jpg\" alt=\"OPPO VIỆT NAM\" title></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">                        \n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-5\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><b><a href=\"oppo.html\" class=\"text-primary text-title\">OPPO VIỆT NAM</a></b></h6>\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><i>Điện tử / Công nghệ cao / Thiết bị phụ trợ / Bán lẻ / Bán sỉ / Thương mại</i></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">OPPO là thương hiệu công nghệ toàn cầu, tiên phong mang đến những sản phẩm và dịch vụ thông minh với thiết kế tối giản tinh tế cùng trải nghiệm vượt trội.</p>\n                        <div class=\"link-wrap mb-4\">\n                            <h6 class=\"link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showLink\" data-app-selector=\".link\">\n                                <a href=\"mondelez-kinh-do-vietnam.html\" class=\"text-primary\"></a><a href=\"oppo.html\" class=\"text-primary\">Tìm hiểu thêm </a><span style=\"font-size: 1.4rem; vertical-align: middle\"><a href=\"mondelezinternational.html\" class=\"text-primary\">➝</a></span>\n                            </h6>\n                        </div>\n                    </div>                    \n                </div>\n            </div>\n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"roxgroup.html\"><img src=\"@PROJECT_PATH@/assets/images/rox.jpg\" alt=\"ROX GROUP\" title></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">                        \n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-5\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><b><a href=\"roxgroup.html\" class=\"text-primary text-title\">ROX GROUP</a></b></h6>\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><i>Đa ngành (Bất động sản / Dịch vụ bất động sản / Xây dựng / Kiến trúc / Ngân hàng…)</i></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">ROX Group thành lập từ 1996, đầu tư đa ngành tiên phong kiến tạo giá trị thông qua hệ sinh thái phát triển đô thị &amp; khu công nghiệp, dịch vụ, tài chính.</p>\n                        <div class=\"link-wrap mb-4\">\n                            <h6 class=\"link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showLink\" data-app-selector=\".link\">\n                                <a href=\"saint-gobain-vietnam.html\" class=\"text-primary\"></a><a href=\"roxgroup.html\" class=\"text-primary\">Tìm hiểu thêm </a><span style=\"font-size: 1.4rem; vertical-align: middle\"><a href=\"saint-gobain.html\" class=\"text-primary\">➝</a></span>\n                            </h6>\n                        </div>\n                    </div>                    \n                </div>\n            </div>\n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"msb.html\"><img src=\"@PROJECT_PATH@/assets/images/msb.jpg\" alt=\"NGÂN HÀNG MSB\" title></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">                        \n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-5\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><b><a href=\"msb.html\" class=\"text-primary text-title\">NGÂN HÀNG MSB</a></b></h6>\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><i>Ngân hàng</i></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">MSB là ngân hàng TMCP đầu tiên ra đời trong thời kỳ kinh tế mở cửa và phát triển của Việt Nam. 30 năm hình thành và phát triển với tinh thần tiên phong.</p>\n                        <div class=\"link-wrap mb-4\">\n                            <h6 class=\"link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showLink\" data-app-selector=\".link\">\n                                <a href=\"vietinbank-vbi.html\" class=\"text-primary\"></a><a href=\"msb.html\" class=\"text-primary\">Tìm hiểu thêm </a><span style=\"font-size: 1.4rem; vertical-align: middle\"><a href=\"myvbi.html\" class=\"text-primary\">➝</a></span>\n                            </h6>\n                        </div>\n                    </div>                    \n                </div>\n            </div>\n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"wipro.html\"><img src=\"@PROJECT_PATH@/assets/images/wipro.jpg\" alt=\"WIPRO CONSUMER CARE VIỆT NAM\" title></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">                        \n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-5\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><b><a href=\"wipro.html\" class=\"text-primary text-title\">WIPRO CONSUMER CARE VIỆT NAM</a></b></h6>\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><i>Hàng tiêu dùng</i></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">Wipro, công ty hàng đầu Đông Nam Á, mang đến Việt Nam hơn 300 sản phẩm chăm sóc cá nhân và gia đình chất lượng cao như Romano, Enchanteur, Bio-essence.</p>\n                        <div class=\"link-wrap mb-4\">\n                            <h6 class=\"link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showLink\" data-app-selector=\".link\">\n                                <a href=\"wipro.html\" class=\"text-primary\"></a><a href=\"wipro.html\" class=\"text-primary\">Tìm hiểu thêm </a><span style=\"font-size: 1.4rem; vertical-align: middle\"><a href=\"wipro-consumer-care-vietnam.html\" class=\"text-primary\">➝</a></span>\n                            </h6>\n                        </div>\n                    </div>                    \n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
