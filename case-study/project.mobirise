            ".iconfont-wrapper": {
              "display": "inline-block",
              "font-size": "20px",
              "border-radius": "50%",
              "width": "35px",
              "height": "35px",
              "line-height": "35px",
              "text-align": "center",
              "transition": "all 0.3s ease-in-out"
            },
            "& when (@squareIcons)": {
              ".iconfont-wrapper": {
                "border-radius": "0 !important"
              }
            },
            "[class^=\"socicon-\"]:before, [class*=\" socicon-\"]:before": {
              "line-height": "35px",
              "padding": ".4rem"
            },
            ".m-2": {
              "margin": "0.2rem!important"
            },
            ".text-info": {
              "color": "#ffc000!important"
            },
            "@media (max-width: 768px)": {
              ".media-wrap img": {
                "width": "45%"
              },
              ".social-list": {
                "text-align": "left"
              },
              ".text-content": {
                "text-align": "left"
              },
              ".text-content-left": {
                "padding-bottom": "1rem"
              }
            },
            "H5": {
