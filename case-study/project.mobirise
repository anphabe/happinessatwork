    "mb-bank-haw-24.html": {
      "settings": {
        "title": "MB Bank: Hành trình kiến tạo môi trường làm việc hạnh phúc từ chiến lược đến hành động",
        "order": "11",
        "meta_descr": "Trong bối cảnh thị trường lao động ngày càng cạnh tranh và kỳ vọng của người lao động không ngừng gia tăng, MB Bank đã thể hiện tầm nhìn tiên phong khi xác định “Hạnh phúc của người lao động” là một trong những chiến lược ưu tiên. Năm 2024, MB Bank vinh dự được trao chứng nhận “Doanh Nghiệp có Nguồn Nhân Lực Hạnh Phúc 2024” do Anphabe tổ chức. Kết quả này không chỉ phản ánh sự hài lòng của nhân viên, mà còn là minh chứng cho chiến lược nhân sự bài bản và nỗ lực không ngừng nghỉ trong việc kiến tạo một môi trường làm việc hạnh phúc, gắn kết và phát triển."
      },
      "components": [
        {
          "alias": false,
          "_styles": {
