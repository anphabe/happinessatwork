    "bidv-haw-24.html": {
      "settings": {
        "title": "Nhân sự hanh phúc, đồng hành cùng phát triển tại BIDV",
        "order": "3",
        "meta_descr": "Tự hào trở thành “Doanh nghiệp có Nguồn Nhân Lực Hạnh Phúc 2024”, BIDV không chỉ khẳng định vị thế là một trong những định chế tài chính lớn và lâu đời nhất tại Việt Nam, mà còn không ngừng phát triển nhờ chiến lược lấy con người làm trọng tâm. Việc xem nhân sự là nguồn lực then chốt đã trở thành kim chỉ nam giúp BIDV duy trì tăng trưởng dài hạn và thích ứng linh hoạt trước mọi biến động của thị trường."
      },
      "components": [
        {
          "alias": false,
