    "saint-gobain-vietnam-haw-24.html": {
      "settings": {
        "title": "Saint-Gobain Việt Nam: Gieo mầm hạnh phúc bằng niềm tin - trao quyền - hợp tác",
        "order": "8",
        "meta_descr": "Trong ngành vật liệu xây dựng vốn mang tính kỹ thuật cao và nhiều áp lực vận hành, việc kiến tạo một môi trường làm việc hạnh phúc không phải là điều dễ dàng. Nhưng Saint-Gobain Việt Nam (SGVN), thành viên của tập đoàn hàng đầu thế giới với hơn 350 năm lịch sử, đã kiên định theo đuổi mục tiêu đó. Và hành trình này đã được ghi nhận xứng đáng khi doanh nghiệp được vinh danh là “Doanh Nghiệp có Nguồn Nhân Lực Hạnh Phúc 2024”, do Anphabe tổ chức."
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
                "min-height": "60px"
              },
              "nav.navbar": {
                "position": "fixed"
              }
            },
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            ".dropdown-menu": {
