 col-md-6 col-lg-{{cardsWidth}} active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"image-list\">\n                        <a href=\"vbi-haw-24.html\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/vbi-image-4.jpeg\" alt title></a>\n                        \n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><a href=\"vbi-haw-24.html\" class=\"text-primary\" target=\"_blank\"><b>Câu chuyện của VBI: Không có tổ chức thành công nếu thiếu đi những con người hạnh phúc</b></a></h5>                        \n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">Trong hơn hai thập kỷ hình thành và phát triển, Tổng công ty Bảo hiểm VietinBank (VBI) không chỉ khẳng định vị thế trên thị trường bảo hiểm phi nhân thọ, mà còn từng bước tạo dựng niềm tin vững chắc từ đội ngũ nội bộ...</p>\n                        <div class=\"link-wrap mb-4\">\n                            <h6 class=\"link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showLink\" data-app-selector=\".link\">\n                                <a class=\"text-primary\" href=\"https://nghenghiepcuocsong.vn/khoi-xuong-chuong-trinh-chung-nhan-doanh-nghiep-co-nguon-nhan-luc-hanh-phuc/\" target=\"_blank\"><b></b></a><b><a href=\"vbi-haw-24.html\" class=\"text-primary\" target=\"_blank\"><b>Xem thêm</b> </a><span style=\"font-size: 1.4rem; vertical-align: middle\"><a href=\"vbi-haw-24.html\" class=\"text-primary\" target=\"_blank\">➝</a></span></b>\n                            </h6>\n                        </div>\n                    </div>                    \n                </div>\n          