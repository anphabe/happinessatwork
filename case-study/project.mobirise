              "padding": "0.5rem",
              "height": "2.5rem",
              "width": "2.5rem"
            },
            ".mbr-iconfont": {
              "color": "black"
            },
            "@media (max-width: 991px)": {
              "div > *:last-child": {
                "margin-top": "0 !important"
              }
            },
            ".copyright": {
              "font-size": "0.9rem",
              "text-align": "left"
            },
            "a.text-primary": {
              "color": "#bbbbbb!important"
            },
            "a.text-primary:link, a.text-primary:hover, a.text-primary:active": {
              "color": "#bbbbbb!important"
            },
            "h5": {
              "border-bottom": "1px solid #bbbbbb"
            },
            ".media-wrap img": {
              "width": "70%"
            },
            ".bg-linkedin when (@linkedin)": {
