    "aeon-viet-nam-haw-24.html": {
      "settings": {
        "title": "Nuôi dưỡng hành phúc và phát triển sự nghiệp bền vững tại AEON Việt Nam",
        "order": "2",
        "meta_descr": "Là 1 trong 12 doanh nghiệp được vinh danh là “Doanh nghiệp có Nguồn Nhân Lực Hạnh Phúc 2024” do Anphabe tổ chức, AEON Việt Nam, con người luôn là trung tâm trong mọi chiến lược phát triển, nơi mỗi nhân viên không chỉ được trao cơ hội nghề nghiệp mà còn được nuôi dưỡng toàn diện cả về năng lực chuyên môn, tư duy lãnh đạo và giá trị cộng đồng.",
        "header_custom": ""
      },
      "components": [
        {
