              "text-align": "left"
            }
          },
          "_name": "content5",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content5\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\"><b>Chiến lược an sinh toàn diện, nâng cao chất lượng cuộc sống</b></h3>                \n                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Từ năm 2021, chiến lược An Sinh FWD LiveLife đã được FWD Việt Nam triển khai và liên tục cải tiến, tạo nên những thay đổi tích cực trong đời sống nhân viên. Chiến lược này tập trung vào 5 trụ cột quan trọng: Mục đích và ý nghĩa cuộc sống, sức khỏe thể chất, sức khỏe cảm xúc, sức khỏe tài chính và gắn kết xã hội. Đặc biệt, việc kết hợp hiệu quả chương trình An Sinh này với nền tảng học tập trực tuyến Anytime Learning thông qua LinkedIn Learning đã giúp nhân viên nâng cao kỹ năng chuyên môn, đồng thời cải thiện chất lượng cuộc sống cá nhân. \n<br>\n<br>Điểm nhấn nổi bật từ chiến lược An Sinh này chính là khả năng giúp nhân viên cân bằng giữa công việc và cuộc sống, khơi gợi niềm đam mê và hứng thú, từ đó thúc đẩy hiệu suất làm việc và gắn kết sâu sắc với tổ chức.&nbsp;<br></p>\n</div>\n        </div>\n    </div>\n</section>",
