            }
          },
          "_name": "content5",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content5\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\"></h3>                \n                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Bên cạnh đó, chương trình VBI Top 100 dành riêng cho nhóm nhân tài chiến lược được triển khai với tiêu chí, phúc lợi và lộ trình phát triển riêng biệt. Tất cả thành viên trong nhóm đều được phỏng vấn đánh giá năng lực chuyên sâu, xây dựng kế hoạch phát triển cá nhân (IDP) và tham gia các khóa đào tạo chuyên biệt nhằm rút ngắn khoảng cách từ tiềm năng đến thành tựu.&nbsp;<br></p>\n</div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_isUserblock": true,
          "_cid": "uQZoe5V5le",
          "_anchor": "content5-au",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".mbr-text": {
              "text-align": "left"
            }
          },
          "_name": "content5",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content5\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\"><b>Trách nhiệm xã hội: Phụng sự cộng đồng - bồi đắp tinh thần gắn bó&nbsp;</b></h3>                \n                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Tại VBI, triết lý “phụng sự xã hội thông qua kinh doanh” không chỉ thể hiện ở sản phẩm mang tính hữu ích mà còn lan tỏa qua những hành động thiết thực hướng đến cộng đồng. Trong năm 2023, VBI đã tài trợ hơn 460 triệu đồng để xây dựng điểm trường tại Huổi Meo (Điện Biên), trao tặng 74 phần quà cho thầy cô và học sinh tại địa phương, góp phần mang tri thức đến vùng khó khăn. \n<br>\n<br>Không dừng lại ở hoạt động từ thiện, VBI cũng đặc biệt quan tâm đến đời sống người lao động. Trong năm vừa qua, tổng ngân sách công đoàn dành cho các hoạt động thăm hỏi, trợ cấp, hiếu hỉ, sinh nhật… lên tới 532,7 triệu đồng, trong đó có hỗ trợ trực tiếp cho 7 đoàn viên gặp hoàn cảnh đặc biệt với tổng số tiền 135 triệu đồng.&nbsp;<br></p>\n</div>\n        </div>\n    </div>\n</section>",
