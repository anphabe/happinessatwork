            },
            ".text-info": {
              "color": "#ffc000!important"
            },
            "@media (max-width: 768px)": {
              ".media-wrap img": {
                "width": "45%"
              },
              ".social-list": {
                "text-align": "left"
              },
              ".text-content": {
                "text-align": "left"
              },
              ".text-content-left": {
                "padding-bottom": "1rem"
              }
            },
            "H5": {
              "text-align": "left"
            },
            "a[class*=\"text-\"]:not(.nav-link):not(.dropdown-item):not([role]):not(.navbar-caption):hover": {
              "background-image": "none"
            }
