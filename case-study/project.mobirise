    "capitaland-haw-24.html": {
      "settings": {
        "title": "CapitaLand: Xây dựng môi trường làm việc trao quyền và ghi nhận",
        "order": "4",
        "meta_descr": "Với tư duy chiến lược đặt nhân sự làm trọng tâm trong mọi chiến lược, CapitaLand không chỉ xây dựng môi trường làm việc hạnh phúc và chuyên nghiệp, mà còn coi đây là nền tảng để phát triển bền vững tổ chức. Mọi chính sách, hoạt động nhân sự đều hướng đến việc tương tác cởi mở, trao quyền, đánh giá và phát triển dài hạn cho mỗi cá nhân. Nhờ những nỗ lực này CapitaLand được vinh danh trở thành “Doanh nghiệp có Nguồn Nhân Lực Hạnh Phúc 2024”"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
