          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "f88-25.html": {
      "settings": {
        "title": "F88 - “Excel with Joy”: Khi hạnh phúc trở thành năng lực cạnh tranh của tổ chức",
        "order": "4",
        "meta_descr": "Triết lý “Excel with Joy - Vui đời Tiến bộ” được F88 xác lập như kim chỉ nam cho mọi quyết định và hành động. Đây không chỉ là một thông điệp văn hóa, mà là cách doanh nghiệp định hình chiến lược nhân sự, phong cách lãnh đạo và trải nghiệm làm việc hằng ngày, qua đó giúp F88 duy trì mức độ gắn kết cao của đội ngũ ngay cả khi thị trường nhiều biến động."
      },
      "components": [
        {
          "alias": false,
