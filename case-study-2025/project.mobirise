      "settings": {
        "main": true,
        "title": "Doanh nghiệp hạnh phúc 2025 | Happiness At Work Certification",
        "meta_descr": "Chương trình Chứng nhận Nguồn Nhân Lực Hạnh Phúc sẽ tiến hành khảo sát doanh nghiệp toàn diện, từ khảo sát nhân viên đến các chia sẻ từ Lãnh Đạo. Chỉ khi các minh chứng thực tế và dữ liệu khảo sát đáp ứng được mức chuẩn của chương trình, doanh nghiệp sẽ được Ban Tổ Chức cấp Chứng nhận Doanh nghiệp tiêu biểu có Nguồn Nhân Lực Hạnh Phúc.",
        "header_custom": "<meta property=\"og:site_name\" content=\"Chứng nhận Nguồn Nhân Lực Hạnh Phúc - Happiness At Work Certification | Anphabe\"/>\n<meta property=\"og:rich_attachment\" content=\"true\"/>\n<meta property=\"og:type\" content=\"website\"/>\n<meta name=\"image\" property=\"og:image\" content=\"https://happinessatwork.vn/assets/images/homepage-cover-1.jpg\">\n<meta property=\"og:url\" itemprop=\"url\" content=\"https://happinessatwork.vn/\"/>\n<meta name=\"twitter:image:src\" content=\"https://happinessatwork.vn/assets/images/homepage-cover-1.jpg\">\n<meta name=\"author\" content=\"Anphabe\">",
