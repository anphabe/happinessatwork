n\" class=\"form-control\" value required>\n                                          <div class=\"invalid-feedback text-start mbr-fonts-style\">Vui lòng nhập chức vụ của bạn</div>\n                                      </div>\n                                      <div class=\"col-sm-12 form-group mb-3\" data-for=\"companyname\">\n                                          <input type=\"text\" name=\"companyname\" placeholder=\"Tên công ty\" data-form-field=\"companyname\" class=\"form-control\" value required>\n                                          <div class=\"invalid-feedback text-start mbr-fonts-style\">Vui lòng nhập tên công ty</div>\n                                      </div>\n                                      <div class=\"col-sm-12 form-group mb-3\" data-for=\"company-size\">\n                                        <select class=\"form-control\" title=\"company-size\" name=\"company-size\" data-form-field=\"company-size\" required>\n                                          <option value>Quy mô công ty</option>\n                                          <option value=\"Dưới 200 nhân viên\">Dưới 200 nhân viên</option>\n                                          <option value=\"Từ 200 - 500 nhân viên\">Từ 200 - 500 nhân viên</option>\n                                          <option value=\"Từ 500 - 800 nhân viên\">Từ 500 - 800 nhân viên</option>\n                                          <option value=\"Từ 800 - 1.000 nhân viên\">Từ 800 - 1.000 nhân viên</option>\n                                          <option value=\"Từ 1.000 - 2.500 nhân viên\">Từ 1.000 - 2.500 nhân viên</option>\n                                          <option value=\"Từ 2.500 nhân viên - 5.000 nhân viên\">Từ 2.500 - 5.000 nhân viên</option>\n                                          <option value=\"Trên 5.000 nhân viên\">Trên 5.000 nhân viên</option>\n                                        </select>\n                                        <div class=\"invalid-feedback tex