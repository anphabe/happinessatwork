&& bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row align-items-start\">\n            <div class=\"col-12 col-lg-4 mt-4 frame-winner\">\n                  <div class=\"image-wrapper\">\n                      <div class=\"d-flex justify-content-center\">\n                        <img class=\"logo-winner\" src=\"@PROJECT_PATH@/assets/images/18.png\" alt=\"Mobirise Website Builder\">\n                      </div>\n                      <p style=\"color:white\" class=\"mbr-description mbr-fonts-style pt-2 d-flex justify-content-center\" mbr-theme-style=\"display-7\" mbr-if=\"showDescription\" data-app-selector=\".mbr-description\"><b style>CÔNG TY TNHH MM Mega Market Việt Nam</b></p>\n                  </div>\n            </div>\n            <div class=\"col-12 col-lg-8\">\n                <div class=\"text-wrapper\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style mb-3 mt-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"><b>Giới thiệu công ty</b></h3>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                        Thành lập năm 2002, MM Mega Market Việt Nam là nhà tiên phong mô hình Trung tâm Bán sỉ Hiện đại, cung cấp nguồn cung đa dạng, đảm bảo chất lượng cho hàng trăm ngàn khách hàng chuyên nghiệp trên toàn quốc.<br><br>Với hơn 21 Trung tâm Bán sỉ &amp; Siêu thị, MM Mega Market cam kết Giải pháp Phù hợp, đáp ứng m