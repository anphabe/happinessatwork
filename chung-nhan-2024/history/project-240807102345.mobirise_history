'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    \n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\">\n            <b>Testimonials</b>\n        </h3>\n        <div class=\"row justify-content-center\">\n            <div class=\"item features-without-image mb-5 col-12 col-md-{{columns}}\">\n                <div class=\"item-wrapper\">\n                    <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">MB đã thể hiện nỗ lực vượt bậc trong việc xây dựng môi trường làm việc hạnh phúc cho nhân viên, bao gồm việc tạo cơ hội phát triển cho nhân tài, thúc đẩy văn hóa học tập và sáng tạo, cũng như chú trọng đến sự hài lòng và gắn kết của nhân viên.<br><br>Các hoạt động đổi mới của MB như áp dụng phương pháp Agile, Design Thinking, và đầu tư mạnh mẽ vào công nghệ đã giúp cải thiện hiệu suất làm việc và trải nghiệm của nhân viên. Điều này không chỉ tạo ra một môi trường làm việc năng động, mà còn khẳng định cam kết của MB trong việc xây dựng nguồn nhân lực hạnh phúc và bền vững. </p>\n                    <div class=\"d-flex mb-md-0 mb-4 info-testimonial\">\n                        <div class=\"image-wrapper\">\n                            <img src=\"@PROJECT_PATH@/assets/images/thanh-nguyen.jpg\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"text-wrapper\">\n                 