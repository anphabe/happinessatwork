            "<script>\n        const ease = {\n        linear: t => t,\n        inOutQuad: t => t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t,\n        };\n\n        const animateCircle = (circle, targetValue, color) => {\n        const duration = 1500;\n        let startValue = 0;\n        const startTime = Date.now();\n\n        const updateCircle = () => {\n            const elapsedTime = Date.now() - startTime;\n            const progress = Math.min(elapsedTime / duration, 1);\n            const easedProgress = ease.inOutQuad(progress);\n            const currentValue = Math.round(startValue + easedProgress * (targetValue - startValue));\n            \n            const startAngle = 0;\n            const endAngle = currentValue * 3.6; // 1% = 3.6 degrees\n\n            circle.querySelector('span').textContent = `${currentValue}%`;\n            circle.style.background = `conic-gradient(${color} ${startAngle}deg ${endAngle}deg, #eeeeee ${endAngle}deg 360deg)`;\n\n            if (progress < 1) {\n            requestAnimationFrame(updateCircle);\n            }\n        };\n\n        requestAnimationFrame(updateCircle);\n        };\n\n        const counter = (EL) => {\n        const endValue = parseInt(EL.dataset.counter, 10);\n        const color = EL.parentElement.getAttribute('data-color');\n        animateCircle(EL.parentElement, endValue, color);\n        };\n\n        const observerOptions = {\n        root: null,\n        rootMargin: '0px',\n        threshold: 0.1 // Trigger when at least 10% of the element is visible\n        };\n\n        const observerCallback = (entries, observer) => {\n        entries.forEach(entry => {\n            if (entry.isIntersecting) {\n            counter(entry.target);\n            observer.unobserve(entry.target); // Stop observing once the animation has started\n            }\n        });\n        };\n\n        const observer = new IntersectionObserver(observerCallback, observerOptions);\n\n        document.querySelectorAll(\"[data-counter]\").forEach(el => {\n        observer.observe(el);\n        });\n    </script>"
