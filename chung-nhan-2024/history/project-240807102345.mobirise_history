          "_name": "image1",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"image1\" group=\"Images & Videos\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" name=\"textWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDescription\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/badge-1.png\" alt=\"Mobirise Website Builder\">\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-8\">\n                <div class=\"text-wrapper\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Giới thiệu doanh nghiệp</b></h3>\n                   <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Được thành lập vào năm 2002, MM Mega Market Việt Nam là công ty tiên phong trong phân phối bán buôn hiện đại, cung cấp đa dạng các mặt hàng chất lượng cao thông qua chuỗi cung ứng khép kín cho hàng trăm nghìn khách hàng chuyên nghiệp trên toàn quốc với 90% hàng hóa có nguồn gốc tại Việt Nam từ thực phẩm khô đến thực phẩm tươi sống và phi thực phẩm.</p>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">MM Mega Market Việt Nam mang đến trải nghiệm mua sắm đa kênh nhanh nhất, tiện lợi nhất, an toàn nhất và toàn diện nhất cho người tiêu dùng, từ khách hàng chuyên nghiệp đến cả khách hàng hộ gia đình.</p>\n\n                    <h3 class=\"mbr-section-title mbr-fonts-style align-center mt-4 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>Định hướng chiến lược xây dựng nguồn nhân lực hạnh phúc</b></h3>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">MM Mega Market Việt Nam theo đuổi triết lý 3C: lấy Khách Hàng làm Trung tâm, Chủ Động Thay Đổi và Thúc Đẩy Cộng tác - kim chỉ nam cho mọi hoạt động kinh doanh và quản lý nhân sự. Triết lý này bao gồm những nội dung chính:</p>\n                    <ul>\n                        <li class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Đối xử với nhân viên công bằng, tin tưởng và tôn trọng.</li>\n                        <li class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Tạo môi trường năng động thông qua không gian làm việc thoải mái, khơi dậy tiềm năng của nhân viên.</li>\n                        <li class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Trao quyền và phát triển nhân tài để cùng công ty phát triển.</li>\n                        <li class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Xây dựng tinh thần đồng đội và hợp tác trên toàn nhóm để đạt được mục tiêu chung.</li>\n                    </ul>\n\n                    <div class=\"row chart-info\">\n                        <div class=\"col-12 col-lg-4 mb-3\">\n                            <div class=\"item-wrapper d-flex justify-content-center\">\n                                <div class=\"circle-style progress-circle1 item-wrapper\" data-circle=\"84\" data-color=\"#ffc000\">\n                                    <span data-counter=\"84\" data-start=\"0\" class=\"mbr-description mbr-fonts-style\" mbr-theme-style=\"display-7\">84%</span>\n                                </div>\n                            </div>                 \n                            <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-description\"><b>Nhân viên tự hào khi là một thành viên của công ty</b></p>\n                        </div>\n\n                        <div class=\"col-12 col-lg-4 mb-3\">\n                            <div class=\"item-wrapper d-flex justify-content-center\">\n                                <div class=\"circle-style progress-circle2 item-wrapper\" data-circle=\"83\" data-color=\"#ffc720\">\n                                    <span data-counter=\"83\" data-start=\"0\" class=\"mbr-description mbr-fonts-style\" mbr-theme-style=\"display-7\">83%</span>\n                                </div>\n                            </div>                 \n                            <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-description\"><b>Nhân viên cam kết với thành công &amp; tương lai của công ty</b><br></p>\n                        </div>\n\n                        <div class=\"col-12 col-lg-4 mb-3\">\n                            <div class=\"item-wrapper d-flex justify-content-center\">\n                                <div class=\"circle-style progress-circle3 item-wrapper\" data-circle=\"74\" data-color=\"#fcd04c\">\n                                    <span data-counter=\"74\" data-start=\"0\" class=\"mbr-description mbr-fonts-style\" mbr-theme-style=\"display-7\">74%</span>\n                                </div>\n                            </div>                 \n                            <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-description\"><b>Nhân viên thấy thoải mái và được là chính mình tại đây</b><br></p>\n                        </div>\n                    </div>\n                </div>\n            </div>        \n            \n        </div>\n    </div>\n\n\n    \n    <script>\n        const ease = {\n        linear: t => t,\n        inOutQuad: t => t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t,\n        };\n\n        const animateCircle = (circle, targetValue, color) => {\n        const duration = 1500;\n        let startValue = 0;\n        const startTime = Date.now();\n\n        const updateCircle = () => {\n            const elapsedTime = Date.now() - startTime;\n            const progress = Math.min(elapsedTime / duration, 1);\n            const easedProgress = ease.inOutQuad(progress);\n            const currentValue = Math.round(startValue + easedProgress * (targetValue - startValue));\n            \n            const startAngle = 0;\n            const endAngle = currentValue * 3.6; // 1% = 3.6 degrees\n\n            circle.querySelector('span').textContent = `${currentValue}%`;\n            circle.style.background = `conic-gradient(${color} ${startAngle}deg ${endAngle}deg, #eeeeee ${endAngle}deg 360deg)`;\n\n            if (progress < 1) {\n            requestAnimationFrame(updateCircle);\n            }\n        };\n\n        requestAnimationFrame(updateCircle);\n        };\n\n        const counter = (EL) => {\n        const endValue = parseInt(EL.dataset.counter, 10);\n        const color = EL.parentElement.getAttribute('data-color');\n        animateCircle(EL.parentElement, endValue, color);\n        };\n\n        const observerOptions = {\n        root: null,\n        rootMargin: '0px',\n        threshold: 0.1 // Trigger when at least 10% of the element is visible\n        };\n\n        const observerCallback = (entries, observer) => {\n        entries.forEach(entry => {\n            if (entry.isIntersecting) {\n            counter(entry.target);\n            observer.unobserve(entry.target); // Stop observing once the animation has started\n            }\n        });\n        };\n\n        const observer = new IntersectionObserver(observerCallback, observerOptions);\n\n        document.querySelectorAll(\"[data-counter]\").forEach(el => {\n        observer.observe(el);\n        });\n    </script>\n</section>",
