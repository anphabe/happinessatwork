pe !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/badge-1.png\" alt=\"Mobirise Website Builder\">\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-8\">\n                <div class=\"text-wrapper\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Giới thiệu doanh nghiệp</b></h3>\n                   <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Wipro là công ty sản xuất và kinh doanh sản phẩm chăm sóc cá nhân hàng đầu tại thị trường Đông Nam Á với các nhãn hàng chuyên biệt cho người Á châu phục vụ hàng triệu người tiêu dùng mỗi ngày. </p>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Wipro đã mang đến Việt Nam hơn 300 sản phẩm Chăm sóc cá nhân và Chăm sóc gia đình chất lượng cao, với các thương hiệu quốc tế nổi tiếng: Romano, Enchanteur, Gervenne, Bio-essence, Carrie Junior, Aiken, MaxKleen... </p>\n\n                    <h3 class=\"mbr-section-title mbr-fonts-style align-center mt-4 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>Định hướng chiến lược xây dựng nguồn nhân lực hạnh phúc</b></h3>\n                    <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Tại Wipro, con người là trọng tâm và tài sản quý giá nhất. Wipro cam kết tạo ra một môi trường - nơi mọi cá nhân đều được đối xử với sự tôn trọng và khuyến khích việc học hỏi, chia sẻ và phát triển. Mỗi nhân viên tại đây đều cảm thấy được đón nhận và trân trọng, những giá trị này thể hiện qua một môi trường làm việc thân thiện, hỗ trợ và khuyến khích phản hồi mang tính xây dựng. Đó chính là chìa khóa cho sự thành công bền vững của Wipro. </p>\n\n\n                    <div class=\"row chart-info\">\n                        <div class=\"col-12 col-lg-4 mb-3\">\n                            <div class=\"item-wrapper d-flex justify-content-center\">\n                                <div class=\"circle-style progress-circle1 item-wrapper\" data-circle=\"91\" data-color=\"#ffc000\">\n                                    <span data-counter=\"91\" data-start=\"0\" class=\"mbr-description mbr-fonts-style\" mbr-theme-style=\"display-7\">91%</span>\n                                </div>\n                            </div>                 \n                            <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-description\"><b>Nhân viên tự hào khi là một thành viên của công ty</b></p>\n                        </div>\n\n                        <div class=\"col-12 col-lg-4 mb-3\">\n                            <div class=\"item-wrapper d-flex justify-content-center\">\n                                <div class=\"circle-style progress-circle2 item-wrapper\" data-circle=\"89\" data-color=\"#ffc720\">\n                                    <span data-counter=\"89\" data-start=\"0\" class=\"mbr-description mbr-fonts-style\" mbr-theme-style=\"display-7\">89%</span>\n                                </div>\n                            </div>                 \n                            <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-description\"><b>Nhân viên&nbsp;tin tưởng vào tầm nhìn &amp; chiến lược của công ty</b><br></p>\n                        </div>\n\n                        <div class=\"col-12 col-lg-4 mb-3\">\n                            <div class=\"item-wrapper d-flex justify-content-center\">\n                                <div class=\"circle-style progress-circle3 item-wrapper\" data-circle=\"85\" data-color=\"#fcd04c\">\n                                    <span data-counter=\"85\" data-start=\"0\" class=\"mbr-description mbr-fonts-style\" mbr-theme-style=\"display-7\">85%</span>\n                                </div>\n                            </div>                 \n                            <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-description\"><b>Nhân viên</b>&nbsp;<b>tìm thấy niềm vui &amp; hứng khởi trong môi trường này</b><br></p>\n                        </div>\n                    </div>\n                </div>\n            </div>        \n            \n        </div>\n    </div>\n\n\n    \n    [JS_CODE_0]\n</section>",
