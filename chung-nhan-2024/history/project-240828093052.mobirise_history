'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    \n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\">\n            <b>Testimonials</b>\n        </h3>\n        <div class=\"row justify-content-center\">\n            <div class=\"item features-without-image mb-5 col-12 col-md-{{columns}}\">\n                <div class=\"item-wrapper\">\n                    <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Mondelez Kinh Đô Việt Nam đã chứng minh sự cam kết mạnh mẽ trong việc xây dựng một môi trường làm việc hạnh phúc và phát triển toàn diện cho nhân viên. Đặc biệt, công ty đã đạt được những kết quả ấn tượng với 90% nhân viên tham gia các khóa đào tạo hàng năm và tỉ lệ trên 50% các vị trí quản lý được kế nhiệm bởi nguồn nội tại. Bên cạnh đó, hơn 55% lãnh đạo cấp cao là nữ giới, thể hiện sự đa dạng và công bằng trong quản lý.<br><br>Những nỗ lực này không chỉ nâng cao năng lực cá nhân mà còn củng cố sự gắn kết và lòng trung thành của nhân viên, góp phần xây dựng một doanh nghiệp vững mạnh và phát triển bền vững.<br></p>\n                    <div class=\"d-flex mb-md-0 mb-4 info-testimonial\">\n                        <div class=\"image-wrapper\">\n                            <img src=\"@PROJECT_PATH@/assets/images/thanh-nguyen.jpg\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"text-wrapper\">\n                            <p class=\"name mbr-fonts-style mb-1\" mbr-if=\"showName\" mbr-theme-style=\"display-4\" data-app-selector=\".name\">\n                                <b>THANH NGUYỄN</b></p>\n                            <p class=\"position mbr-fonts-style\" mbr-if=\"showPosition\" mbr-theme-style=\"display-4\" data-app-selector=\".position\">GĐĐH &amp; Truyền cảm hứng hạnh phúc tại Anphabe</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
